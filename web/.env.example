GL_WEB_ENDPOINT=http://127.0.0.1:7882
# Exact browser origin, including the port. Use HTTPS for remote production access.
GL_WEB_ORIGIN=http://localhost:3000
# Set a unique cryptographically random value of at least 32 characters.
GL_WEB_SESSION_SECRET=
# Optional online raster basemap (XYZ template). Unset keeps the offline blank basemaps and strict CSP.
# GL_WEB_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GL_WEB_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

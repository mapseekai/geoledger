{
  "name": "@geoledger/console",
  "version": "0.3.0-alpha.5",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.boundaries.json",
    "test": "node ../scripts/run-ts-tests.mjs tsx",
    "format:check": "prettier --check src test *.json *.ts *.mjs .oxlintrc*.json",
    "format": "prettier --write src test *.json *.ts *.mjs .oxlintrc*.json",
    "lint": "python3 ../scripts/check-test-layout.py && oxlint src test --deny-warnings && oxlint --type-aware -c .oxlintrc.typed.json src test --deny-warnings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@geoledger/client": "file:../sdk/ts",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "epsg-index": "2.0.0",
    "iron-session": "9.0.1",
    "lossless-json": "4.3.1",
    "lucide-react": "1.53.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "proj4": "2.22.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.3",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

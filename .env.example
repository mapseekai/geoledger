# Copy to .env and load it into your shell explicitly; automatic dotenv loading is not implemented.
SV_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SV_AUTHOR=Alan
# Optional per-statement timeout for CLI/serve; default 120 seconds, must be positive.
# SV_STATEMENT_TIMEOUT_SECS=900
# SV_API_TOKEN must be a randomly generated token of at least 24 bytes.
# Integration tests only: database must be named spatial_version_test.
# SV_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:PORT/spatial_version_test

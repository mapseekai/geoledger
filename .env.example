# Copy to .env and load it into your shell explicitly; automatic dotenv loading is not implemented.
GL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GL_AUTHOR=Alan
# Optional per-statement timeout for CLI/serve; default 120 seconds, must be positive.
# GL_STATEMENT_TIMEOUT_SECS=900
# GL_API_TOKEN must be a randomly generated token of at least 24 bytes.
# Integration tests only: database must be named geoledger_test.
# GL_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:PORT/geoledger_test

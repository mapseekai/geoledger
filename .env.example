# Copy to .env and load it into your shell explicitly.
# Fill connection variables with real endpoints for your development environment.
# Development database role: mapseekai.
# GL_DATABASE_URL=
GL_AUTHOR=mapseekai
# Per-statement timeout in seconds; default 120, range 1..2147483.
# GL_STATEMENT_TIMEOUT_SECS=900
# Set GL_API_TOKEN to a randomly generated token of at least 24 bytes.
# GL_API_TOKEN=
# Integration tests use a dedicated database named geoledger_test.
# GL_TEST_DATABASE_URL=

# GeoLedger configuration template. Every variable mirrors a geoledger-server flag
# (`geoledger-server --help`); values below are the built-in defaults unless noted.
# Copy to .env and load the values you need into the service environment; Docker
# Compose reads .env for ${...} interpolation. Never commit the copy.
# scripts/check-env.py keeps this file in sync with the server and CLI flags.

# --- Storage ---------------------------------------------------------------
GL_STORAGE=sqlite
GL_DATA_DIR=./geoledger-data
# PostGIS: GL_STORAGE=postgis plus a private URL. TLS is verified by default
# (sslmode=verify-full); add sslrootcert=<CA PEM> for a private CA.
# GL_DATABASE_URL=postgresql://geoledger:<password>@db.internal:5432/geoledger?sslmode=verify-full&sslrootcert=/etc/geoledger/tls/ca.crt
# Allow sslmode=disable to a non-loopback database (trusted private network only).
# GL_DATABASE_ALLOW_PLAINTEXT=false
# GL_DB_POOL_SIZE=20
# GL_DB_STATEMENT_TIMEOUT_SECS=30
# GL_DB_LOCK_TIMEOUT_SECS=10

# --- Listeners and TLS -----------------------------------------------------
GL_HTTP_LISTEN=127.0.0.1:7881
GL_GRPC_LISTEN=127.0.0.1:7882
# Server-side TLS for both listeners; GL_TLS_CLIENT_CA additionally requires client certificates (mTLS).
# GL_TLS_CERT=/etc/geoledger/tls/server.crt
# GL_TLS_KEY=/etc/geoledger/tls/server.key
# GL_TLS_CLIENT_CA=
# Optional plaintext listener with only /health and /ready (container probes).
# GL_HEALTH_LISTEN=127.0.0.1:7880

# --- Identity --------------------------------------------------------------
# Static tokens (hashed). Default: GL_DATA_DIR/tokens.json, created on first start
# together with admin-credentials.json unless GL_BOOTSTRAP_ADMIN=false.
# GL_TOKEN_FILE=
# GL_BOOTSTRAP_ADMIN=true
# JWT (RS256): one of GL_JWKS_FILE or GL_JWKS_URL, plus issuer and audience.
# GL_JWKS_FILE=
# GL_JWKS_URL=https://idp.example/.well-known/jwks.json
# GL_JWKS_REFRESH_SECS=300
# GL_JWT_ISSUER=
# GL_JWT_AUDIENCE=
# Token, JWKS and TLS files are re-read when they change (and on SIGHUP).
# GL_RELOAD_INTERVAL_SECS=10

# --- Platform policy -------------------------------------------------------
# GL_ADMIN_SUBJECTS=ops-admin,security-admin
# GL_PROJECT_CREATION=anyone
# GL_MAX_PROJECTS_PER_SUBJECT=0

# --- Limits, rate limiting and shutdown ------------------------------------
# GL_MAX_CONCURRENCY=20
# GL_REQUEST_TIMEOUT_SECS=30
# GL_RATE_LIMIT_SUBJECT_RPS=0
# GL_RATE_LIMIT_SUBJECT_BURST=50
# GL_RATE_LIMIT_IP_RPS=0
# GL_RATE_LIMIT_IP_BURST=100
# Only behind a trusted gateway that sets X-Forwarded-For.
# GL_TRUST_FORWARDED_FOR=false
# GL_SHUTDOWN_DRAIN_SECS=0
# GL_SHUTDOWN_TIMEOUT_SECS=30
# Deadline for backup, restore, export, import and verify.
# GL_DATA_TIMEOUT_SECS=3600
# Logging (JSON): RUST_LOG=geoledger_server=info,geoledger_engine=info

# --- gl CLI and SDKs -------------------------------------------------------
GL_ENDPOINT=http://127.0.0.1:7882
# One of GL_TOKEN or GL_TOKEN_FILE (a client credential such as admin-credentials.json).
# GL_TOKEN=
# Private CA for https endpoints (gl CLI / Rust SDK).
# GL_CA_FILE=
# Plaintext http:// to a non-loopback host is refused unless this is true.
# GL_ALLOW_INSECURE_TRANSPORT=false

# --- Tests and drills ------------------------------------------------------
# Disposable database named geoledger_test for opt-in PostGIS tests.
# GL_TEST_DATABASE_URL=
# Empty PostGIS database for scripts/backup-drill.sh to import into.
# GL_DRILL_DATABASE_URL=

# --- Compose (compose.yaml console profile, deploy/compose.production.yaml) --
# GL_WEB_ORIGIN=http://localhost:3000
# GL_WEB_SESSION_SECRET=
# GL_DB_PASSWORD=
# The native console template is web/.env.example.

# SQLite requires the trusted native SpatiaLite extension (installed by the Docker image).
# GL_SPATIALITE_EXTENSION=/usr/lib/x86_64-linux-gnu/mod_spatialite.so

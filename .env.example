# Copy to .env and explicitly load the selected values into your shell.
# geoledger-server reads environment variables; Docker Compose also reads .env.
GL_STORAGE=sqlite
GL_DATA_DIR=./geoledger-data
GL_HTTP_LISTEN=127.0.0.1:7881
GL_GRPC_LISTEN=127.0.0.1:7882
# Optional static credentials; default is GL_DATA_DIR/tokens.json.
# GL_TOKEN_FILE=
# PostGIS: set GL_STORAGE=postgis and supply a private connection URL.
# GL_DATABASE_URL=
# JWT authentication: configure these three values together.
# GL_JWKS_FILE=
# GL_JWT_ISSUER=
# GL_JWT_AUDIENCE=
# CLI / SDK connection.
GL_ENDPOINT=http://127.0.0.1:7882
# GL_TOKEN=
# Integration tests: dedicated disposable database named geoledger_test.
# GL_TEST_DATABASE_URL=
# Optional Compose console profile. Generate a random secret before startup.
# GL_WEB_ORIGIN=http://localhost:3000
# GL_WEB_SESSION_SECRET=
# Native Web configuration template is web/.env.example.

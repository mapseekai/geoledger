# Copy to .env and load it into your shell explicitly.
# Use the actual connection string for your development database.
# GL_DATABASE_URL=
# Per-statement timeout in seconds.
# GL_STATEMENT_TIMEOUT_SECS=900
# Use a randomly generated token of at least 24 bytes.
# GL_API_TOKEN=
# Integration tests use a dedicated database named geoledger_test.
# GL_TEST_DATABASE_URL=
# Center edition: dedicated PostGIS service role and operator token JSON file.
# GL_CENTER_DATABASE_URL=
# GL_CENTER_TOKEN_FILE=
# Center operation deadline in milliseconds.
# GL_CENTER_OPERATION_TIMEOUT_MS=30000

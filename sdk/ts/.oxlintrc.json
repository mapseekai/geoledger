{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": "error"
  },
  "ignorePatterns": [
    "src/_internal/geoledger/**",
    "src/**/*.test.ts"
  ]
}

{
  "name": "@geoledger/client",
  "version": "0.4.0-alpha.1",
  "description": "GeoLedger business client for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapseekai/geoledger.git",
    "directory": "sdk/ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node ../../scripts/run-ts-tests.mjs strip-types",
    "lint": "python3 ../../scripts/check-test-layout.py && oxlint --type-aware src --deny-warnings"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@grpc/grpc-js": "1.14.7",
    "lossless-json": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "ts-proto": "2.22.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}

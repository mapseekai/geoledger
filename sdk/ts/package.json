{
  "name": "@geoledger/client",
  "version": "0.3.0-alpha.4",
  "description": "GeoLedger business client for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapseekai/geoledger.git",
    "directory": "sdk/ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test test/client.test.cjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.6",
    "lossless-json": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ts-proto": "2.15.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }

[Unit]
Description=GeoLedger online SQLite backup
# Runs next to geoledger.service; the backup is a consistent snapshot while it serves.
After=geoledger.service
[Service]
Type=oneshot
User=geoledger
Group=geoledger
WorkingDirectory=/var/lib/geoledger
Environment=GL_DATA_DIR=/var/lib/geoledger
Environment=GL_BACKUP_DIR=/var/backups/geoledger
Environment=GL_BACKUP_KEEP_DAYS=14
EnvironmentFile=-/etc/geoledger/environment
# Each run writes a new timestamped file (never overwrites), verifies it, then
# prunes local copies older than GL_BACKUP_KEEP_DAYS. Ship the files off-host.
ExecStart=/bin/sh -c 'exec /usr/local/bin/geoledger-server backup --output "$$GL_BACKUP_DIR/geoledger-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).sqlite3"'
ExecStartPost=/bin/sh -c 'find "$$GL_BACKUP_DIR" -maxdepth 1 -name "geoledger-*.sqlite3" -mtime "+$$GL_BACKUP_KEEP_DAYS" -delete'
ReadWritePaths=/var/lib/geoledger /var/backups/geoledger
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
